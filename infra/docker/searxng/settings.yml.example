# Author: MilanWoj
# Copy this file to settings.yml and set your own secret_key
# (generate one with: openssl rand -hex 32)
use_default_settings: true

general:
  instance_name: "loculus-search"
  privacypolicy_url: false
  donation_url: false
  contact_url: false

server:
  secret_key: "REPLACE ME"
  limiter: false
  image_proxy: false
  port: 8888
  bind_address: "0.0.0.0"

search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json

ui:
  static_use_hash: true

engines:
  - name: wikipedia
    disabled: false
  - name: google
    disabled: false
  - name: bing
    disabled: false
  - name: duckduckgo
    disabled: false
  - name: brave
    disabled: false
  - name: startpage
    disabled: true
  - name: yahoo
    disabled: true
  - name: wikidata
    disabled: true